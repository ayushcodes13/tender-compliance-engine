{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tender-compliance-engine.invalid/schemas/phase-1-v2-source-annotation-v1.json",
  "title": "Phase 1 v2 source-region annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "protocolVersion", "annotationId", "status", "corpusSplit", "source", "scope", "review", "anchors", "regions", "labels", "disagreements", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "const": 1 },
    "annotationId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "reviewed_pending_adjudication", "adjudicated", "unresolved"] },
    "corpusSplit": { "enum": ["development", "validation", "locked_evaluation"] },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["documentId", "fileName", "sha256", "physicalPageCount"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "fileName": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "physicalPageCount": { "type": "integer", "minimum": 1 }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "physicalPagesReviewed", "wholeDocumentReviewed", "statement"],
      "properties": {
        "task": { "type": "string", "minLength": 1 },
        "physicalPagesReviewed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "wholeDocumentReviewed": { "type": "boolean" },
        "statement": { "type": "string", "minLength": 1 },
        "printedPageLabels": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["physicalPage", "printedLabel"],
            "properties": {
              "physicalPage": { "type": "integer", "minimum": 1 },
              "printedLabel": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "reviewers", "independentReviewComplete", "adjudicationNotes"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "reviewers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reviewer" } },
        "independentReviewComplete": { "type": "boolean" },
        "adjudicationNotes": { "type": "string" }
      }
    },
    "anchors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/anchor" } },
    "regions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/region" } },
    "labels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/label" } },
    "disagreements": { "type": "array", "items": { "$ref": "#/$defs/disagreement" } },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "date", "regionIds"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "regionIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "physicalPage", "quote", "quoteVerification", "locationPrecision", "locationNote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "physicalPage": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "quoteVerification": { "enum": ["exact", "whitespace_normalized", "ocr_transcript", "visual_transcription", "unverified"] },
        "locationPrecision": { "enum": ["exact", "approximate", "page_only", "unknown"] },
        "locationNote": { "type": "string", "minLength": 1 },
        "parser": { "type": ["object", "null"] },
        "sourceElementIds": { "type": "array", "items": { "type": "string" } },
        "startOffset": { "type": ["integer", "null"], "minimum": 0 },
        "endOffset": { "type": ["integer", "null"], "minimum": 0 },
        "offsetUnit": { "type": ["string", "null"] },
        "offsetScope": { "type": ["string", "null"] },
        "boundingBox": { "type": ["array", "null"], "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "coordinateSystem": { "type": ["string", "null"] }
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "physicalPage", "kind", "label", "coverage", "sourceAnchorIds", "reviewNote"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "physicalPage": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["paragraph", "table_row", "table_cell", "heading", "header_footer", "form", "image_region", "page_region", "other"] },
        "label": { "type": "string", "minLength": 1 },
        "coverage": { "enum": ["complete_in_scope", "partial", "unreviewed", "unreadable", "not_applicable"] },
        "sourceAnchorIds": { "type": "array", "items": { "type": "string" } },
        "reviewNote": { "type": "string", "minLength": 1 }
      }
    },
    "value": {
      "type": "object", "additionalProperties": false,
      "required": ["raw", "role"],
      "properties": {
        "raw": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "normalized": { "type": ["string", "number", "null"] }
      }
    },
    "label": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "interpretation", "sourceAnchorIds", "atomicity", "modality", "values", "conditions", "uncertainty", "reviewDisposition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["technical_requirement", "service_fulfilment", "documentation_deliverable", "administrative_form", "explicit_non_requirement", "ambiguous", "unresolved"] },
        "interpretation": { "type": "string", "minLength": 1 },
        "sourceAnchorIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "atomicity": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "groupId", "rationale"],
          "properties": {
            "status": { "enum": ["independent", "grouped", "undetermined", "not_applicable"] },
            "groupId": { "type": ["string", "null"] },
            "rationale": { "type": "string", "minLength": 1 }
          }
        },
        "modality": { "type": "array", "items": { "type": "string" } },
        "values": { "type": "array", "items": { "$ref": "#/$defs/value" } },
        "conditions": { "type": "array", "items": { "type": "string" } },
        "uncertainty": { "type": "array", "items": { "type": "string" } },
        "reviewDisposition": { "enum": ["retain", "exclude_with_reason", "needs_adjudication", "unresolved"] }
      }
    },
    "disagreement": {
      "type": "object", "additionalProperties": false,
      "required": ["regionId", "question", "positions", "resolution"],
      "properties": {
        "regionId": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "positions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "resolution": { "type": ["string", "null"] }
      }
    }
  }
}
