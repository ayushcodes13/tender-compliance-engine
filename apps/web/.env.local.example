# Frontend development configuration.
# Copy this file to .env.local and adjust as needed.
# .env.local is git-ignored and never committed.

# URL of the FastAPI backend (CP10 project API lives at /projects).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Development identity headers. The backend auto-creates User and
# Organization rows in dev mode, but requires a Membership row to already
# exist. To seed one, run after `make api-migrate`:
#
#   cd apps/api && python -c "
#   import asyncio, uuid
#   from tender_compliance_api.db.session import init_engine, get_session
#   from tender_compliance_api.db.models import Organization, User, Membership
#
#   async def main():
#       init_engine('postgresql+asyncpg://tender:tender@localhost:5433/tender')
#       async with get_session() as s:
#           s.add(Organization(id=uuid.UUID('$(NEXT_PUBLIC_DEV_ORG_ID)'), name='Dev Org'))
#           s.add(User(id=uuid.UUID('$(NEXT_PUBLIC_DEV_USER_ID)'), auth_provider='dev', auth_provider_user_id='$(NEXT_PUBLIC_DEV_USER_ID)'))
#           s.add(Membership(organization_id=uuid.UUID('$(NEXT_PUBLIC_DEV_ORG_ID)'), user_id=uuid.UUID('$(NEXT_PUBLIC_DEV_USER_ID)'), role='owner'))
#           await s.commit()
#   asyncio.run(main())
#   "
NEXT_PUBLIC_DEV_USER_ID=00000000-0000-0000-0000-000000000001
NEXT_PUBLIC_DEV_ORG_ID=00000000-0000-0000-0000-000000000002
