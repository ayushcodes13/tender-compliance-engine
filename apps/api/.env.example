# =============================================================================
# Environment configuration for Tender Compliance Engine (CP47)
# =============================================================================
# Copy this file to `.env` and fill in real values.  NEVER commit `.env`.
# All secrets are read from environment variables — never from config files.
# =============================================================================

# --- Application ---
APP_ENV=production
APP_NAME=tender-compliance-engine
API_HOST=0.0.0.0
API_PORT=8000

# --- Database ---
# PostgreSQL connection string.  Use SSL in production.
DATABASE_URL=postgresql+asyncpg://tce:tce-password@postgres:5432/tce

# --- Object Storage (S3-compatible, e.g. MinIO locally) ---
OBJECT_STORAGE_ENDPOINT=https://minio.example.com
OBJECT_STORAGE_ACCESS_KEY=tce-access-key
OBJECT_STORAGE_SECRET_KEY=tce-secret-key
OBJECT_STORAGE_BUCKET=tender-documents
OBJECT_STORAGE_REGION=us-east-1

# --- Redis (queue/broker) ---
REDIS_URL=redis://redis:6379/0

# --- LLM Extraction (CP26) ---
# OpenAI is the default provider.  The key is read from the environment;
# it is never logged or committed.
OPENAI_API_KEY=sk-
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Optional strict second pass only when a proposed source quote fails the
# deterministic source check. Recovered candidates enter human review.
VERBATIM_VALIDATION_FALLBACK_ENABLED=false

# --- Processing Limits ---
MAX_RETRIES=5
MAX_CONCURRENCY=4
UPLOAD_MAX_BYTES=52428800    # 50 MB
MAX_PDF_PAGES=500
REQUEST_TIMEOUT_SECONDS=30

# --- Retention Policy ---
RETENTION_ORIGINALS_DAYS=90
RETENTION_RENDERED_DAYS=30
RETENTION_EXPORTS_DAYS=30

# --- CORS ---
# Comma-separated list of allowed origins in production.
CORS_ALLOWED_ORIGINS=https://app.example.com

# --- TLS ---
# TLS is handled by the reverse proxy / load balancer, not the app itself.
# The app should be reachable only via the proxy in production.
