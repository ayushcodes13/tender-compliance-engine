# =============================================================================
# Local docker-compose development environment (CP47)
# =============================================================================
# Copy this file to `apps/api/.env.local` and adjust as needed.
# This file is git-ignored — never commit real secrets here.
# Values below match the local docker-compose.yml service names.
# =============================================================================

# --- Application ---
APP_ENV=development
APP_NAME=tender-compliance-engine
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (matches the postgres service in docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://tce:tce-password@postgres:5432/tce

# --- Object Storage (MinIO local service) ---
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=tce-access-key
OBJECT_STORAGE_SECRET_KEY=tce-secret-key
OBJECT_STORAGE_BUCKET=tender-documents
OBJECT_STORAGE_REGION=us-east-1

# --- Redis (matches the redis service in docker-compose.yml) ---
REDIS_URL=redis://redis:6379/0

# --- LLM extraction and strict page-image fallback ---
# Use the Azure AI Foundry OpenAI v1 URL here when applicable:
# https://<resource>.openai.azure.com/openai/v1/
# The model/deployment must support image input and structured outputs.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# --- Processing Limits ---
MAX_RETRIES=5
MAX_CONCURRENCY=4
UPLOAD_MAX_BYTES=52428800    # 50 MB
MAX_PDF_PAGES=500
REQUEST_TIMEOUT_SECONDS=30

# --- Retention Policy ---
RETENTION_ORIGINALS_DAYS=90
RETENTION_RENDERED_DAYS=30
RETENTION_EXPORTS_DAYS=30

# --- CORS (web service) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
