# Tender Compliance Engine — bundled single-workspace beta
#
# Quick start:
#   cp .env.example .env
#   set OPENAI_API_KEY below
#   docker compose up --build
#
# Then open http://localhost:3000.

# Required AI credential.
# docker compose intentionally refuses to start until this is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=

# Browser/API URLs
# The bundled stack uses the same-origin Next.js proxy automatically.
# Override NEXT_PUBLIC_API_URL only when running the frontend against a
# separately hosted API.
NEXT_PUBLIC_API_URL=/api/backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Single-workspace beta identity. No manual database seed is required.
SINGLE_WORKSPACE_USER_ID=00000000-0000-0000-0000-000000000001
SINGLE_WORKSPACE_ORG_ID=00000000-0000-0000-0000-000000000002
SINGLE_WORKSPACE_ORG_NAME=Tender Compliance Workspace

# Bundled infrastructure defaults. Change these before exposing the stack
# outside a private pilot environment.
POSTGRES_DB=tce
POSTGRES_USER=tce
POSTGRES_PASSWORD=tce-password
MAX_CONCURRENCY=4

# Optional cloud/S3 storage override. Leave these empty for the bundled pilot,
# which persists originals/pages/exports in the Docker object_data volume.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=tender-documents
OBJECT_STORAGE_REGION=us-east-1
