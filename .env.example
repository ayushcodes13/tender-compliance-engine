# GPT-6 Luna is the only model used for tender extraction. Keep the key in .env.local.
OPENAI_API_KEY=
# Optional, private/local encrypted SQLite run store. Generate a unique 32-byte key with `openssl rand -hex 32`.
# Leave unset to keep current runs in memory. Never commit a real key. This adapter is not durable on Vercel/serverless.
TCE_RUN_STORE_KEY=
# Optional absolute/relative SQLite file path; defaults to .local/analysis-runs.sqlite under the app process directory.
TCE_RUN_STORE_PATH=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-luna
# Required in production. Basic-auth username is `tender`.
APP_ACCESS_PASSWORD=
# Optional local OCR settings. Tesseract 5 plus the selected language data are required.
TESSERACT_BINARY=
TESSERACT_LANG=eng
PDFTOPPM_BINARY=
