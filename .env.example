# Application
APP_ENV=development
APP_NAME=tender-compliance-engine
API_HOST=0.0.0.0
API_PORT=8000
WEB_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=tender_compliance
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender_local_only
DATABASE_URL=postgresql+asyncpg://tender:tender_local_only@localhost:5432/tender_compliance

# Redis / background jobs
REDIS_URL=redis://localhost:6379/0

# S3-compatible object storage (MinIO locally)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=tender-documents
OBJECT_STORAGE_REGION=us-east-1

# AI/OCR provider configuration
# Keep real keys only in your local .env or secret manager.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
OCR_PROVIDER=
OCR_API_KEY=
